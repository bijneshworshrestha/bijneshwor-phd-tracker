{
  "_name": "Stark Tech Design System — Token Reference",
  "_applied_to": "PhD Tracker (Bijneshwor Shrestha)",
  "_date": "2026-09-18",

  "colors": {
    "_note": "dark values are the defaults; light values activate under prefers-color-scheme:light or data-theme='light'",
    "paper":       { "dark": "#04070c",  "light": "#e7edf5",  "usage": "page background" },
    "surface":     { "dark": "#0a1220",  "light": "#ffffff",  "usage": "card / panel background" },
    "surface-2":   { "dark": "#0f1b2d",  "light": "#eef3fa",  "usage": "subtle inset / input background" },
    "line":        { "dark": "#1c3049",  "light": "#ccd7e6",  "usage": "borders and dividers" },
    "ink":         { "dark": "#e7f3ff",  "light": "#101825",  "usage": "primary text" },
    "ink-soft":    { "dark": "#91acc7",  "light": "#48576b",  "usage": "secondary text / labels" },
    "muted":       { "dark": "#6f88a3",  "light": "#647287",  "usage": "placeholder / disabled text" },
    "muted-soft":  { "dark": "#101c2c",  "light": "#e9eef5",  "usage": "very subtle backgrounds" },
    "accent":      { "dark": "#00d9ff",  "light": "#0072ce",  "usage": "primary interactive colour (cyan / cerulean)" },
    "accent-soft": { "dark": "#0a2d42",  "light": "#dcedfc",  "usage": "accent background / tint" },
    "accent-glow": { "dark": "rgba(0,217,255,0.35)", "light": "rgba(0,114,206,0.28)", "usage": "glow shadow on accent elements" },
    "good":        { "dark": "#00e6a8",  "light": "#00897b",  "usage": "success / positive states" },
    "good-soft":   { "dark": "#073527",  "light": "#dcf3ef",  "usage": "success background tint" },
    "warn":        { "dark": "#ffb800",  "light": "#b3760a",  "usage": "warning / caution states" },
    "warn-soft":   { "dark": "#3a2a04",  "light": "#faedd6",  "usage": "warning background tint" },
    "skip":        { "dark": "#ff3d63",  "light": "#c62842",  "usage": "error / danger / destructive" },
    "skip-soft":   { "dark": "#3a0f1a",  "light": "#fbe1e6",  "usage": "error background tint" },
    "focus":       { "note": "alias of accent" }
  },

  "shadows": {
    "shadow-card":  {
      "dark":  "0 1px 2px rgba(0,0,0,0.5), 0 0 22px rgba(0,217,255,0.04)",
      "light": "0 1px 2px rgba(0,0,0,0.08), 0 0 22px rgba(0,114,206,0.04)",
      "usage": "default card resting shadow"
    },
    "shadow-hover": {
      "dark":  "0 0 0 1px rgba(0,217,255,0.45), 0 0 26px rgba(0,217,255,0.18)",
      "light": "0 0 0 1px rgba(0,114,206,0.20), 0 0 26px rgba(0,114,206,0.10)",
      "usage": "interactive card hover / active shadow"
    },
    "shadow-glow":  {
      "dark":  "0 0 14px rgba(0,217,255,0.35)",
      "light": "0 0 14px rgba(0,114,206,0.28)",
      "usage": "accent glow on key numbers / badges"
    }
  },

  "typography": {
    "fonts": {
      "sans":  "'Varela Round', system-ui, sans-serif",
      "mono":  "'IBM Plex Mono', ui-monospace, monospace"
    },
    "scales": {
      "heading": { "size": "30px", "lineHeight": "34px", "weight": 400,  "tracking": "0.01em", "family": "sans" },
      "body":    { "size": "15px", "lineHeight": "23px", "weight": 400,  "family": "sans" },
      "label":   { "size": "11px", "lineHeight": "14px", "weight": 600,  "tracking": "0.16em", "transform": "uppercase", "family": "mono" },
      "data-lg": { "size": "24px", "lineHeight": "28px", "weight": 700,  "family": "mono" },
      "data-sm": { "size": "11.5px","lineHeight": "16px", "weight": 500, "family": "mono" }
    }
  },

  "spacing": [4, 8, 12, 16, 20, 24, 32],

  "radii": {
    "sm":     "8px",
    "md":     "14px",
    "lg":     "16px",
    "pill":   "999px",
    "circle": "50%"
  },

  "css_custom_properties": {
    "_note": "These are the actual --var names used in the PhD Tracker HTML",
    "--bg":             "maps to paper",
    "--surface":        "maps to surface",
    "--surface2":       "maps to surface-2",
    "--border":         "maps to line",
    "--text":           "maps to ink",
    "--muted":          "maps to ink-soft (dark) / muted (light)",
    "--accent":         "maps to accent",
    "--accent-dim":     "maps to accent-soft",
    "--accent-glow":    "maps to accent-glow",
    "--red / --red-bg / --red-border":   "maps to skip / skip-soft",
    "--amber / --amber-bg / --amber-border": "maps to warn / warn-soft",
    "--green / --green-bg / --green-border": "maps to good / good-soft",
    "--shadow-sm":      "maps to shadow-card",
    "--shadow":         "maps to shadow-hover",
    "--radius":         "12px (between Stark sm=8px and md=14px)"
  }
}
